MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-host>/"
MONGODB_DB=jobhuntly
# Keep demo listings for the presentation. Set false when switching to real data only.
DEMO_CATALOG_ENABLED=true
# Local development only. On Vercel use https://demojobhuntbyhaseeb.vercel.app
BETTER_AUTH_URL=http://localhost:3000
# Generate a private random value of at least 32 characters. Never commit it.
BETTER_AUTH_SECRET=replace-with-a-private-random-secret
